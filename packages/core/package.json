{
  "name": "@tikka/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit && tsc --noEmit -p src/__tests__/tsconfig.json",
    "test:integration": "tsx src/__tests__/integration.test.ts"
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "^0.30.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "dotenv": "^16.4.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
